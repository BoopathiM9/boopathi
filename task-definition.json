{
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "family": "boopathi-app-task",
  "containerDefinitions": [
    {
      "name": "boopathi-container",
      "image": "384875139605.dkr.ecr.us-east-1.amazonaws.com/boopathi-repo:latest",
      "essential": true,
      "command": [
        "node",
        "app.js"
      ],
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp"
        }
      ]
    }
  ],
  "volumes": [],
  "networkMode": "awsvpc",
  "memory": "512",
  "cpu": "256",
  "executionRoleArn": "arn:aws:iam::384875139605:role/ecsTaskExecutionRole"
}